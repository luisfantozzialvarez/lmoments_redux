Cell[TextData[{
 "Now I compute  the gradient of the quantile derivative function  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["Q", "TI"], "\[Prime]"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], "|", "\[Theta]"}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            StyleBox["f", "TI"], 
            RowBox[{"(", 
              RowBox[{
                StyleBox["Q", "TI"], 
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["u", "TI"], "|", "\[Theta]"}], ")"}], "|", 
                "\[Theta]"}], ")"}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "Q^\\prime(u|\\theta) =  \\frac{1}{f(Q(u|\\theta)|\\theta))}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80564116-2ec3-4c8d-85fb-6429c3689e5e"],
 ":\n"
}], "Text",
 CellChangeTimes->{{3.950360941812381*^9, 3.950360959956545*^9}, {
  3.9503611265020943`*^9, 3.9503611621931963`*^9}, {3.950361298519964*^9, 
