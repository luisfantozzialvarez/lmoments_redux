Cell["\<\
I begin by defining the L-moment function, following the formula provided by \
Hosking (1985):\
\>", "Text",
 CellChangeTimes->{{3.950246793133337*^9, 3.950246818109556*^9}, 
   3.950259764992326*^9},ExpressionUUID->"61511e84-6747-4fc0-827d-\
9de68d6f74e1"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"l_", ",", "m_", ",", " ", "r_", ",", " ", "k_"}], "]"}], ":=", 
     " ", 
     TemplateBox[<|"boxes" -> FormBox[
         RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
              RowBox[{"1", "+", 
                StyleBox["l", "TI"]}], ")"}], "-1"], 
           StyleBox["m", "TI"], "+", 
           SuperscriptBox[
            RowBox[{"(", 
              RowBox[{"1", "+", 
                StyleBox["l", "TI"]}], ")"}], "-1"], 
           StyleBox["r", "TI"], 
           RowBox[{"(", 
             RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{"1", "+", 
                    StyleBox["l", "TI"]}], ")"}], 
                RowBox[{"-", 
                  StyleBox["k", "TI"]}]], 
               RowBox[{"(", 
                 RowBox[{"\[CapitalGamma]", "(", 
                   RowBox[{"1", "+", 
                    StyleBox["k", "TI"]}], ")"}], ")"}]}], ")"}], 
           SuperscriptBox[
            StyleBox["k", "TI"], "-1"]}], TraditionalForm], "errors" -> {}, 
       "input" -> 
       "(1+l)^{-1}m + (1+l)^{-1}r(1-(1+l)^{-k}(\\Gamma(1+k)))k^{-1}", "state" -> 
       "Boxes"|>,
      "TeXAssistantTemplate"]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"l_", ",", "m_", ",", " ", "r_", ",", " ", "0"}], "]"}], ":=", 
     " ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"l", ",", "m", ",", "r", ",", "k"}], "]"}], ",", 
       RowBox[{"k", " ", "->", " ", "0"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.950192140662652*^9, {3.950192458395734*^9, 3.950192458558503*^9}, {
   3.950192504059648*^9, 3.950192510931547*^9}, {3.9501926029279203`*^9, 
