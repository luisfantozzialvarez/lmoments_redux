Cell[CellGroupData[{

Cell["Generalized Pareto Distribution", "Title",
 CellChangeTimes->{{3.950247072934041*^9, 3.950247089100131*^9}, {
  3.95025995181808*^9, 
  3.9502599528102694`*^9}},ExpressionUUID->"a641da1d-7403-4fc9-8ea7-\
db751948529e"],

Cell["Gradient and Hessian of theoretical L-moment function", "Subtitle",
 CellChangeTimes->{{3.950259968369667*^9, 
  3.950260007954273*^9}},ExpressionUUID->"8879a07d-7cfe-4d2e-9e09-\
3904ae2eac93"],

Cell["\<\
Similarly to the GEV case, I define the theoretical L-moment function based \
on Hosking (1985):\
\>", "Text",
 CellChangeTimes->{{3.950259997025956*^9, 
  3.950260041130274*^9}},ExpressionUUID->"a2694e29-4903-48a5-bf56-\
f5acec0c2de1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"l_", ",", "m_", ",", " ", "r_", ",", " ", "k_"}], "]"}], ":=", 
    " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["m", "TI"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               StyleBox["l", "TI"]}], ")"}], "-1"], "+", 
          StyleBox["r", "TI"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               StyleBox["l", "TI"]}], ")"}], "-1"], 
          SuperscriptBox[
           StyleBox["k", "TI"], "-1"], 
          RowBox[{"(", 
            RowBox[{"1", "-", 
              RowBox[{"(", 
                RowBox[{"\[CapitalGamma]", "(", 
                  RowBox[{"1", "+", 
                    StyleBox["k", "TI"]}], ")"}], ")"}], 
              RowBox[{"(", 
                RowBox[{"\[CapitalGamma]", "(", 
                  RowBox[{"2", "+", 
                    StyleBox["l", "TI"]}], ")"}], ")"}], 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{"\[CapitalGamma]", "(", 
                   RowBox[{"2", "+", 
                    StyleBox["k", "TI"], "+", 
                    StyleBox["l", "TI"]}], ")"}], ")"}], "-1"]}], ")"}]}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "m(1+l)^{-1} \
+r(1+l)^{-1}k^{-1}(1-(\\Gamma(1+k))(\\Gamma(2+l))(\\Gamma(2+k+l))^{-1})", 
      "state" -> "TeX"|>,
     "TeXAssistantTemplate"]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"l_", ",", "m_", ",", " ", "r_", ",", " ", "0"}], "]"}], ":=", 
   " ", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"l", ",", "m", " ", ",", "r", ",", " ", "k"}], "]"}], ",", 
     RowBox[{"k", " ", "->", " ", "0"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.950247099893093*^9, 3.95024710162008*^9}, {
   3.9502599550758867`*^9, 3.950259957794558*^9}, {3.950260078579685*^9, 
   3.9502600788436747`*^9}, 3.9502601310363913`*^9, {3.95026024968853*^9, 
   3.950260302203959*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"a3434fa7-b3ac-43a1-9fca-084e9bec31c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "[", 
  RowBox[{"l", ",", "m", ",", "r", ",", " ", "0"}], "]"}]], "Input",
 CellChangeTimes->{{3.950260323915834*^9, 3.950260348066354*^9}, {
  3.950260385637033*^9, 3.950260392194378*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"e9223834-3990-41e0-b5b1-8712703b6695"],

Cell[BoxData[
 RowBox[{
  FractionBox["m", 
   RowBox[{"1", "+", "l"}]], "+", 
  FractionBox[
   RowBox[{"r", " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", "l"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"EulerGamma", "+", 
      RowBox[{"PolyGamma", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", "+", "l"}]}], "]"}]}], ")"}]}], 
   RowBox[{"Gamma", "[", 
    RowBox[{"2", "+", "l"}], "]"}]]}]], "Output",
 CellChangeTimes->{{3.950260314531827*^9, 3.950260348418324*^9}, {
   3.950260383907769*^9, 3.950260393270577*^9}, 3.950366443077445*^9},
 CellLabel->"Out[75]=",ExpressionUUID->"aba28b2a-decd-484b-a253-9a1e5101b2ea"]
}, Open  ]],

Cell["\<\
Next, I compute the gradient and Hessian of the L-moment function:\
\>", "Text",
 CellChangeTimes->{
  3.9502736714258204`*^9},ExpressionUUID->"a57eef28-581a-43b9-a137-\
a3c693a13ab0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grad", "[", 
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"l", ",", "m", ",", "r", ",", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"m", ",", "r", ",", "k"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.950261538862938*^9, 3.9502615584803133`*^9}, {
   3.9502623633982477`*^9, 3.950262431331235*^9}, {3.9502624753380423`*^9, 
   3.950262492120063*^9}, 3.950267105745083*^9, 3.9502671721686897`*^9, {
   3.950267264463105*^9, 3.9502672685579844`*^9}, {3.9502685536485577`*^9, 
   3.9502685588346367`*^9}, {3.950269264288912*^9, 3.950269293375964*^9}, {
   3.950269331898621*^9, 3.950269376086931*^9}, {3.950269832216838*^9, 
   3.950269866997487*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"1b87736a-f22b-4aa8-98ea-7d666825d9e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"1", "+", "l"}]], ",", 
   FractionBox[
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", "k"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"2", "+", "l"}], "]"}]}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "+", "k", "+", "l"}], "]"}]]}], 
    RowBox[{"k", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "l"}], ")"}]}]], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"1", "+", "k"}], "]"}], " ", 
           RowBox[{"Gamma", "[", 
            RowBox[{"2", "+", "l"}], "]"}]}], 
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "+", "k", "+", "l"}], "]"}]]}], ")"}]}], 
      RowBox[{
