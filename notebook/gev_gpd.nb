 CellChangeTimes->{{3.950359092309286*^9, 3.9503591154859037`*^9}, {
  3.950360965603265*^9, 
  3.950360970210774*^9}},ExpressionUUID->"054f4ebd-fd62-4399-ade5-\
59cfc55f2ba0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"q", "[", 
    RowBox[{"u_", ",", "loc_", ",", "scale_", ",", "shape_"}], "]"}], " ", ":=", 
   RowBox[{"(", 
    RowBox[{"loc", "+", 
     RowBox[{"scale", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "u", "]"}]}], ")"}], "^", "shape"}]}], ")"}], 
       "/", "shape"}]}]}], ")"}]}], ";"}]], "Input",
